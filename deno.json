{
  "name": "@chapeaux/porter",
  "version": "0.10.0",
  "exports": "./mod.ts",
  "tasks": {
    "init": "deno run --allow-all cli.ts init",
    "start": "deno run --allow-all cli.ts start",
    "stop": "deno run --allow-all cli.ts stop",
    "status": "deno run --allow-all cli.ts status",
    "deploy": "deno run --allow-all cli.ts deploy",
    "teardown": "deno run --allow-all cli.ts teardown",
    "serve": "deno run --allow-all cli.ts serve",
    "ui": "deno run --allow-all cli.ts ui",
    "ui:standalone": "deno run --allow-all src/ui/server.ts",
    "check": "deno check mod.ts cli.ts worker.ts isolate.ts src/ui/server.ts src/orchestration/registry.ts src/core/model_registry.ts src/auth/model_store.ts src/mcp/mcp_client.ts src/mcp/mcp_server.ts src/auth/mod.ts",
    "test": "deno test --allow-all test/",
    "compile": "deno compile --allow-all --include src/ui/ --include src/graph/shapes.ttl --include isolate.ts --include worker.ts --output porter cli.ts"
  },
  "lint": {
    "exclude": ["src/ui/*.js", "src/ui/**/*.js", "archive/", "src/activitypub/sparq/"],
    "rules": {
      "exclude": ["no-explicit-any", "require-await", "verbatim-module-syntax", "no-unused-vars"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/testing": "jsr:@std/testing@^1",
    "@rdfjs/types": "npm:@rdfjs/types@^2",
    "fzstd": "npm:fzstd@^0.1",
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9"
  }
}
