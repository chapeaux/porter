      "subscribe": ["task", "control"]
    },
    {
      "name": "frontend",
      "role": "worker",
      "system_prompt": "You handle frontend work. Only modify files under src/client/.",
      "tools": ["read_file", "write_file", "edit_file", "bash", "glob", "grep", "list_dir", "git", "send_message", "read_messages"],
      "subscribe": ["task", "control"]
    },
    {
      "name": "reviewer",
      "role": "reviewer",
      "system_prompt": "Review code changes. Run tests and report results to 'log'.",
      "tools": ["read_file", "bash", "glob", "grep", "list_dir", "send_message", "read_messages"],
      "subscribe": ["review"]
    }
  ]
