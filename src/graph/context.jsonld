{
  "@context": {
    "porter": "https://porter.chapeaux.io/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "prov": "http://www.w3.org/ns/prov#",

    "Team": "porter:Team",
    "Agent": "porter:Agent",
    "AgentSlot": "porter:AgentSlot",
    "Model": "porter:Model",
    "McpServer": "porter:McpServer",
    "Pattern": "porter:Pattern",
    "PatternRole": "porter:PatternRole",
    "Session": "porter:Session",
    "Observation": "porter:Observation",
    "Finding": "porter:Finding",
    "Critique": "porter:Critique",
    "PlanStep": "porter:PlanStep",
    "FederationConfig": "porter:FederationConfig",

    "name": "porter:name",
    "displayName": "porter:displayName",
    "teamPattern": "porter:teamPattern",
    "usesModel": "porter:usesModel",
    "apiKeyEnv": "porter:apiKeyEnv",
    "workingDir": "porter:workingDir",
    "maxDeliberationRounds": { "@id": "porter:maxDeliberationRounds", "@type": "xsd:integer" },

    "hasAgentSlot": { "@id": "porter:hasAgentSlot", "@type": "@id", "@container": "@set" },
    "agentRef": "porter:agentRef",
    "assignedRole": "porter:assignedRole",
    "agentExpertise": "porter:agentExpertise",
    "hasTool": { "@id": "porter:hasTool", "@container": "@set" },
    "hasMcpTool": { "@id": "porter:hasMcpTool", "@container": "@set" },
    "subscribesTo": { "@id": "porter:subscribesTo", "@container": "@set" },
    "maxTokens": { "@id": "porter:maxTokens", "@type": "xsd:integer" },
    "maxTurns": { "@id": "porter:maxTurns", "@type": "xsd:integer" },
    "maxContextTokens": { "@id": "porter:maxContextTokens", "@type": "xsd:integer" },
    "reasoning": { "@id": "porter:reasoning", "@type": "xsd:boolean" },
    "visibility": "porter:visibility",
    "derivedFrom": "porter:derivedFrom",
    "linkedFrom": "porter:linkedFrom",

    "hasMcpServer": { "@id": "porter:hasMcpServer", "@type": "@id", "@container": "@set" },
    "transport": "porter:transport",
    "mcpUrl": "porter:mcpUrl",
    "mcpCommand": "porter:mcpCommand",
    "mcpArgs": { "@id": "porter:mcpArgs", "@container": "@set" },
    "authType": "porter:authType",
    "tokenEnv": "porter:tokenEnv",
    "mcpIssuerUrl": "porter:mcpIssuerUrl",

    "sessionEnv": { "@id": "porter:sessionEnv", "@container": "@set" },
    "runtimeTool": { "@id": "porter:runtimeTool", "@container": "@set" },

    "providerType": "porter:providerType",
    "baseUrl": "porter:baseUrl",
    "authMethod": "porter:authMethod",
    "contextWindow": { "@id": "porter:contextWindow", "@type": "xsd:integer" },
    "toolCalling": { "@id": "porter:toolCalling", "@type": "xsd:boolean" },
    "vision": { "@id": "porter:vision", "@type": "xsd:boolean" },
    "jsonMode": { "@id": "porter:jsonMode", "@type": "xsd:boolean" },
    "region": "porter:region",
    "apiVersion": "porter:apiVersion",

    "busFlow": "porter:busFlow",
    "isBuiltin": { "@id": "porter:isBuiltin", "@type": "xsd:boolean" },
    "roleId": "porter:roleId",
    "minCount": { "@id": "porter:minCount", "@type": "xsd:integer" },
    "maxCount": { "@id": "porter:maxCount", "@type": "xsd:integer" },
    "systemPromptSuffix": "porter:systemPromptSuffix",
    "autoTool": { "@id": "porter:autoTool", "@container": "@set" },
    "defaultTool": { "@id": "porter:defaultTool", "@container": "@set" },

    "about": "porter:about",
    "finding": "porter:finding",
    "discoveredBy": "porter:discoveredBy",
    "severity": "porter:severity",
    "domain": "porter:domain",
    "confidence": { "@id": "porter:confidence", "@type": "xsd:float" },
    "round": { "@id": "porter:round", "@type": "xsd:integer" },
    "approved": { "@id": "porter:approved", "@type": "xsd:boolean" },
    "stepOrder": { "@id": "porter:stepOrder", "@type": "xsd:integer" },
    "stepState": "porter:stepState",
    "addresses": "porter:addresses",

    "approvalMode": "porter:approvalMode",
    "allowlistEntry": { "@id": "porter:allowlistEntry", "@container": "@set" },
    "publicSummaries": { "@id": "porter:publicSummaries", "@type": "xsd:boolean" },

    "generatedAtTime": { "@id": "prov:generatedAtTime", "@type": "xsd:dateTime" }
  }
}
