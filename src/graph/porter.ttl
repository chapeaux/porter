@prefix porter: <https://porter.chapeaux.io/vocab#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# Porter Ontology
#
# Formal vocabulary for the Porter multi-agent orchestration platform.
# Namespace: https://porter.chapeaux.io/vocab#
# =============================================================================

<https://porter.chapeaux.io/vocab#> a owl:Ontology ;
  rdfs:label "Porter Ontology" ;
  rdfs:comment "Vocabulary for multi-agent orchestration: teams, agents, models, patterns, collaboration, and federation." ;
  dcterms:creator "Chapeaux Project" ;
  owl:versionInfo "0.15" .

# =============================================================================
# Classes
# =============================================================================

porter:Team a rdfs:Class ;
  rdfs:label "Team" ;
  rdfs:comment "A team of AI agents configured to collaborate via a specific pattern." .

porter:Agent a rdfs:Class ;
  rdfs:label "Agent" ;
  rdfs:comment "An AI agent with domain expertise, tools, and model configuration. Exists independently of teams." .

porter:AgentSlot a rdfs:Class ;
  rdfs:label "Agent Slot" ;
  rdfs:comment "A position within a team that binds an agent to a role. Carries team-specific overrides (role, model) while the agent's canonical definition stays unchanged." .

porter:Model a rdfs:Class ;
  rdfs:label "Model" ;
  rdfs:comment "An AI model endpoint configuration: provider, URL, auth, capabilities, and limits." .

porter:McpServer a rdfs:Class ;
  rdfs:label "MCP Server" ;
  rdfs:comment "A Model Context Protocol server providing external tools to agents." .

porter:Pattern a rdfs:Class ;
  rdfs:label "Pattern" ;
  rdfs:comment "A collaboration pattern defining roles, channels, auto-tools, and system prompt suffixes." .

porter:PatternRole a rdfs:Class ;
  rdfs:label "Pattern Role" ;
  rdfs:comment "A role within a pattern with cardinality constraints and coordination behavior." .

porter:Session a rdfs:Class ;
  rdfs:label "Session" ;
  rdfs:comment "A running instance of a team with active agents, message bus, and metrics." .

porter:Observation a rdfs:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An agent's observation stored in the shared knowledge graph." .

porter:Finding a rdfs:Class ;
  rdfs:subClassOf porter:Observation ;
  rdfs:label "Finding" ;
  rdfs:comment "A domain-specific finding from a mixture pattern specialist." .

porter:Critique a rdfs:Class ;
  rdfs:subClassOf porter:Observation ;
  rdfs:label "Critique" ;
  rdfs:comment "A critique from a deliberation pattern reflector." .

porter:PlanStep a rdfs:Class ;
  rdfs:label "Plan Step" ;
  rdfs:comment "An ordered step in a distillation pattern plan." .

porter:FederationConfig a rdfs:Class ;
  rdfs:label "Federation Config" ;
  rdfs:comment "ActivityPub federation settings for a Porter instance." .

# =============================================================================
# Team Properties
# =============================================================================

porter:name a rdf:Property ;
  rdfs:label "name" ;
  rdfs:comment "The name identifier for a resource." ;
  rdfs:range xsd:string .

porter:teamPattern a rdf:Property ;
  rdfs:label "team pattern" ;
  rdfs:comment "Collaboration pattern: sequential, mixture, deliberation, or distillation." ;
  rdfs:domain porter:Team ;
  rdfs:range xsd:string .

porter:usesModel a rdf:Property ;
  rdfs:label "uses model" ;
  rdfs:comment "The model ID used by a team (default) or agent (override)." ;
  rdfs:range xsd:string .

porter:apiKeyEnv a rdf:Property ;
  rdfs:label "API key env var" ;
  rdfs:comment "Environment variable name containing the API key." ;
  rdfs:range xsd:string .

porter:workingDir a rdf:Property ;
  rdfs:label "working directory" ;
  rdfs:comment "Filesystem path for agent file operations." ;
  rdfs:range xsd:string .

porter:maxDeliberationRounds a rdf:Property ;
  rdfs:label "max deliberation rounds" ;
  rdfs:comment "Maximum worker/reflector cycles in deliberation pattern." ;
  rdfs:domain porter:Team ;
  rdfs:range xsd:integer .

porter:hasAgentSlot a rdf:Property ;
  rdfs:label "has agent slot" ;
  rdfs:comment "Links a team to an agent slot (blank node carrying role assignment and agent reference)." ;
  rdfs:domain porter:Team ;
  rdfs:range porter:AgentSlot .

porter:hasMcpServer a rdf:Property ;
  rdfs:label "has MCP server" ;
  rdfs:comment "Links a team to an inline MCP server configuration." ;
  rdfs:domain porter:Team ;
  rdfs:range porter:McpServer .

porter:sessionEnv a rdf:Property ;
  rdfs:label "session env" ;
  rdfs:comment "Environment variable as KEY=VALUE string, repeated for multiple vars." ;
  rdfs:domain porter:Team ;
  rdfs:range xsd:string .

porter:runtimeTool a rdf:Property ;
  rdfs:label "runtime tool" ;
  rdfs:comment "Runtime tool name injected into sandbox containers (e.g., deno, python3, curl)." ;
  rdfs:domain porter:Team ;
  rdfs:range xsd:string .

# =============================================================================
# Agent Slot Properties
# =============================================================================

porter:agentRef a rdf:Property ;
  rdfs:label "agent ref" ;
  rdfs:comment "Reference to an agent by name or URI." ;
  rdfs:domain porter:AgentSlot ;
  rdfs:range xsd:string .

porter:assignedRole a rdf:Property ;
  rdfs:label "assigned role" ;
  rdfs:comment "Role assigned to an agent within a team: admin, worker, reviewer, specialist, synthesizer, reflector, expert, or learner." ;
  rdfs:range xsd:string .

# =============================================================================
# Agent Properties
# =============================================================================

porter:agentExpertise a rdf:Property ;
  rdfs:label "agent expertise" ;
  rdfs:comment "System prompt describing the agent's domain expertise." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:hasTool a rdf:Property ;
  rdfs:label "has tool" ;
  rdfs:comment "A tool available to the agent (e.g., read_file, bash, send_message)." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:hasMcpTool a rdf:Property ;
  rdfs:label "has MCP tool" ;
  rdfs:comment "An MCP tool binding (e.g., server.* or server.specific_tool)." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:subscribesTo a rdf:Property ;
  rdfs:label "subscribes to" ;
  rdfs:comment "A bus channel the agent subscribes to." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:maxTokens a rdf:Property ;
  rdfs:label "max tokens" ;
  rdfs:comment "Maximum output tokens per model response." ;
  rdfs:range xsd:integer .

porter:maxTurns a rdf:Property ;
  rdfs:label "max turns" ;
  rdfs:comment "Maximum conversation turn pairs kept in context." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:integer .

porter:maxContextTokens a rdf:Property ;
  rdfs:label "max context tokens" ;
  rdfs:comment "Estimated input token budget. Oldest turns dropped when exceeded." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:integer .

porter:reasoning a rdf:Property ;
  rdfs:label "reasoning" ;
  rdfs:comment "Enable extended thinking / reasoning mode." ;
  rdfs:range xsd:boolean .

porter:visibility a rdf:Property ;
  rdfs:label "visibility" ;
  rdfs:comment "Agent sharing visibility: private, shared, or linked." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:derivedFrom a rdf:Property ;
  rdfs:label "derived from" ;
  rdfs:comment "URI of the agent this was copied from." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

porter:linkedFrom a rdf:Property ;
  rdfs:label "linked from" ;
  rdfs:comment "URI of the remote agent this is linked to (live reference)." ;
  rdfs:domain porter:Agent ;
  rdfs:range xsd:string .

# =============================================================================
# Model Properties
# =============================================================================

porter:displayName a rdf:Property ;
  rdfs:label "display name" ;
  rdfs:comment "Human-readable display name." ;
  rdfs:range xsd:string .

porter:providerType a rdf:Property ;
  rdfs:label "provider type" ;
  rdfs:comment "AI provider: openai, openai_compat, azure_openai, anthropic, aws_bedrock, vertex_ai, groq, ollama." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:string .

porter:baseUrl a rdf:Property ;
  rdfs:label "base URL" ;
  rdfs:comment "Provider API base URL." ;
  rdfs:range xsd:string .

porter:authMethod a rdf:Property ;
  rdfs:label "auth method" ;
  rdfs:comment "Authentication method: bearer, adc, aws_iam, x-api-key." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:string .

porter:contextWindow a rdf:Property ;
  rdfs:label "context window" ;
  rdfs:comment "Total token capacity (input + output)." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:integer .

porter:toolCalling a rdf:Property ;
  rdfs:label "tool calling" ;
  rdfs:comment "Model supports native tool/function calling." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:boolean .

porter:vision a rdf:Property ;
  rdfs:label "vision" ;
  rdfs:comment "Model supports image/vision input." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:boolean .

porter:jsonMode a rdf:Property ;
  rdfs:label "JSON mode" ;
  rdfs:comment "Model supports structured JSON output." ;
  rdfs:domain porter:Model ;
  rdfs:range xsd:boolean .

porter:region a rdf:Property ;
  rdfs:label "region" ;
  rdfs:comment "Cloud provider region." ;
  rdfs:range xsd:string .

porter:apiVersion a rdf:Property ;
  rdfs:label "API version" ;
  rdfs:comment "Provider API version string." ;
  rdfs:range xsd:string .

# =============================================================================
# MCP Server Properties
# =============================================================================

porter:transport a rdf:Property ;
  rdfs:label "transport" ;
  rdfs:comment "MCP transport type: stdio or http." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:mcpUrl a rdf:Property ;
  rdfs:label "MCP URL" ;
  rdfs:comment "HTTP endpoint URL for MCP server." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:mcpCommand a rdf:Property ;
  rdfs:label "MCP command" ;
  rdfs:comment "Command to spawn for stdio transport." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:mcpArgs a rdf:Property ;
  rdfs:label "MCP args" ;
  rdfs:comment "Command-line argument for stdio MCP server (repeated)." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:authType a rdf:Property ;
  rdfs:label "auth type" ;
  rdfs:comment "MCP authentication type: bearer, oidc." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:tokenEnv a rdf:Property ;
  rdfs:label "token env" ;
  rdfs:comment "Environment variable name for MCP auth token." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

porter:mcpIssuerUrl a rdf:Property ;
  rdfs:label "MCP issuer URL" ;
  rdfs:comment "OIDC issuer URL for MCP HTTP authentication." ;
  rdfs:domain porter:McpServer ;
  rdfs:range xsd:string .

# =============================================================================
# Pattern Properties
# =============================================================================

porter:busFlow a rdf:Property ;
  rdfs:label "bus flow" ;
  rdfs:comment "Message flow topology description string." ;
  rdfs:domain porter:Pattern ;
  rdfs:range xsd:string .

porter:isBuiltin a rdf:Property ;
  rdfs:label "is builtin" ;
  rdfs:comment "Whether this pattern is a built-in (non-deletable) pattern." ;
  rdfs:domain porter:Pattern ;
  rdfs:range xsd:boolean .

porter:roleId a rdf:Property ;
  rdfs:label "role ID" ;
  rdfs:comment "Identifier for a role within a pattern." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:string .

porter:minCount a rdf:Property ;
  rdfs:label "min count" ;
  rdfs:comment "Minimum agents required for this role." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:integer .

porter:maxCount a rdf:Property ;
  rdfs:label "max count" ;
  rdfs:comment "Maximum agents allowed for this role." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:integer .

porter:systemPromptSuffix a rdf:Property ;
  rdfs:label "system prompt suffix" ;
  rdfs:comment "Text appended to agents' system prompts when using this role." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:string .

porter:autoTool a rdf:Property ;
  rdfs:label "auto tool" ;
  rdfs:comment "Tool automatically injected for agents with this role." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:string .

porter:defaultTool a rdf:Property ;
  rdfs:label "default tool" ;
  rdfs:comment "Default tool included for agents with this role." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:string .

porter:subscribeDynamic a rdf:Property ;
  rdfs:label "subscribe dynamic" ;
  rdfs:comment "Dynamic channel subscription template." ;
  rdfs:domain porter:PatternRole ;
  rdfs:range xsd:string .

# =============================================================================
# Observation / Collaboration Properties
# =============================================================================

porter:about a rdf:Property ;
  rdfs:label "about" ;
  rdfs:comment "What this observation, finding, or critique is about." ;
  rdfs:range xsd:string .

porter:finding a rdf:Property ;
  rdfs:label "finding" ;
  rdfs:comment "The finding text or critique issue." ;
  rdfs:range xsd:string .

porter:discoveredBy a rdf:Property ;
  rdfs:label "discovered by" ;
  rdfs:comment "Agent name that discovered or authored this observation." ;
  rdfs:range xsd:string .

porter:severity a rdf:Property ;
  rdfs:label "severity" ;
  rdfs:comment "Severity level: info, low, medium, high, critical." ;
  rdfs:domain porter:Observation ;
  rdfs:range xsd:string .

porter:domain a rdf:Property ;
  rdfs:label "domain" ;
  rdfs:comment "Domain specialization: security, performance, architecture, etc." ;
  rdfs:domain porter:Finding ;
  rdfs:range xsd:string .

porter:confidence a rdf:Property ;
  rdfs:label "confidence" ;
  rdfs:comment "Confidence score from 0 to 1." ;
  rdfs:domain porter:Finding ;
  rdfs:range xsd:float .

porter:round a rdf:Property ;
  rdfs:label "round" ;
  rdfs:comment "Deliberation round number." ;
  rdfs:domain porter:Critique ;
  rdfs:range xsd:integer .

porter:approved a rdf:Property ;
  rdfs:label "approved" ;
  rdfs:comment "Whether the critique has been addressed." ;
  rdfs:domain porter:Critique ;
  rdfs:range xsd:boolean .

porter:stepOrder a rdf:Property ;
  rdfs:label "step order" ;
  rdfs:comment "Ordinal position of a plan step." ;
  rdfs:domain porter:PlanStep ;
  rdfs:range xsd:integer .

porter:stepState a rdf:Property ;
  rdfs:label "step state" ;
  rdfs:comment "Current state: pending, done, or failed." ;
  rdfs:domain porter:PlanStep ;
  rdfs:range xsd:string .

porter:addresses a rdf:Property ;
  rdfs:label "addresses" ;
  rdfs:comment "Notes on what a plan step addresses or resolves." ;
  rdfs:domain porter:PlanStep ;
  rdfs:range xsd:string .

# =============================================================================
# Federation Properties
# =============================================================================

porter:approvalMode a rdf:Property ;
  rdfs:label "approval mode" ;
  rdfs:comment "Follow request handling: open, allowlist, or manual." ;
  rdfs:domain porter:FederationConfig ;
  rdfs:range xsd:string .

porter:allowlistEntry a rdf:Property ;
  rdfs:label "allowlist entry" ;
  rdfs:comment "Domain or @user@domain handle to auto-approve (repeated)." ;
  rdfs:domain porter:FederationConfig ;
  rdfs:range xsd:string .

porter:publicSummaries a rdf:Property ;
  rdfs:label "public summaries" ;
  rdfs:comment "Post session summaries publicly (vs followers-only)." ;
  rdfs:domain porter:FederationConfig ;
  rdfs:range xsd:boolean .
