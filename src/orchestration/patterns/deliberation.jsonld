{
  "@context": {
    "porter": "https://porter.chapeaux.io/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "name": "porter:name",
    "description": "porter:description",
    "bus_flow": "porter:busFlow",
    "builtin": { "@id": "porter:isBuiltin", "@type": "xsd:boolean" },
    "max_rounds": { "@id": "porter:maxRounds", "@type": "xsd:integer" },
    "roles": { "@id": "porter:hasRole", "@container": "@set" },
    "min": { "@id": "porter:minCount", "@type": "xsd:integer" },
    "max": { "@id": "porter:maxCount", "@type": "xsd:integer" },
    "system_prompt_suffix": "porter:systemPromptSuffix",
    "auto_tools": { "@id": "porter:autoTool", "@container": "@set" },
    "subscribe": { "@id": "porter:subscribesTo", "@container": "@set" },
    "subscribe_dynamic": "porter:subscribeDynamic",
    "default_tools": { "@id": "porter:defaultTool", "@container": "@set" },
    "Pattern": "porter:Pattern",
    "PatternRole": "porter:PatternRole"
  },
  "@id": "porter:pattern/deliberation",
  "@type": "Pattern",
  "id": "deliberation",
  "name": "Deliberation",
  "description": "A reflector iteratively critiques a worker's output, triggering corrections until the work is approved or the round limit is reached. Graph-tracked critiques prevent regression.",
  "bus_flow": "task -> role:worker -> deliberation -> role:reflector -> (approve -> response | revision -> role:worker)",
  "builtin": true,
  "max_rounds": 3,
  "roles": [
    {
      "@type": "PatternRole",
      "id": "worker",
      "name": "Worker",
      "description": "Executes tasks, revises based on reflector feedback",
      "min": 1,
      "max": 1,
      "system_prompt_suffix": "You are the worker in a Deliberation team. Complete the task using your tools. When done, publish a summary of your work to the 'deliberation' channel via send_message. If you receive critique on the 'revision' channel, use critiques_query to see specific issues and address each one. You have {max_rounds} deliberation rounds.",
      "auto_tools": ["critiques_query", "send_message"],
      "subscribe": ["task", "revision", "control"],
      "default_tools": ["read_file", "write_file", "edit_file", "bash", "glob", "grep", "list_dir", "git"]
    },
    {
      "@type": "PatternRole",
      "id": "reflector",
      "name": "Reflector",
      "description": "Reviews worker output, provides critique or approves",
      "min": 1,
      "max": 1,
      "system_prompt_suffix": "You are the reflector in a Deliberation team. Review the worker's output on the 'deliberation' channel. Check for: correctness, completeness, edge cases, security issues. Use critique_write for each issue found — be specific and actionable. If the work is acceptable, use the approve tool to end the deliberation loop.",
      "auto_tools": ["critique_write", "approve", "send_message"],
      "subscribe": ["deliberation", "control"],
      "default_tools": ["read_file", "glob", "grep", "list_dir"]
    },
    {
      "@type": "PatternRole",
      "id": "librarian",
      "name": "Librarian",
      "description": "Optional: curates which session-local memories are worth keeping across sessions, and resolves conflicts in durable memory",
      "min": 0,
      "max": 1,
      "system_prompt_suffix": "You are the librarian for this team. Other agents record memories locally with the memory tool as they work. Periodically use memory({method:\"search\", scope:\"local\"}) to review what's been recorded. Use memory_admin({method:\"promote\", id:\"...\"}) to promote genuinely reusable facts and lessons to durable, cross-session memory — not every observation deserves to be durable, only stable facts and generalizable lessons. If a promotion conflicts with an existing durable fact, memory_admin will tell you and give you an id to resolve it with memory_admin({method:\"adjudicate\", ...}).",
      "auto_tools": ["memory", "memory_admin", "send_message"],
      "subscribe": ["memory", "control"],
      "default_tools": []
    }
  ]
}
