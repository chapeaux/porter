{
  "@context": {
    "porter": "https://porter.chapeaux.io/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "name": "porter:name",
    "description": "porter:description",
    "bus_flow": "porter:busFlow",
    "builtin": { "@id": "porter:isBuiltin", "@type": "xsd:boolean" },
    "max_rounds": { "@id": "porter:maxRounds", "@type": "xsd:integer" },
    "roles": { "@id": "porter:hasRole", "@container": "@set" },
    "min": { "@id": "porter:minCount", "@type": "xsd:integer" },
    "max": { "@id": "porter:maxCount", "@type": "xsd:integer" },
    "system_prompt_suffix": "porter:systemPromptSuffix",
    "auto_tools": { "@id": "porter:autoTool", "@container": "@set" },
    "subscribe": { "@id": "porter:subscribesTo", "@container": "@set" },
    "subscribe_dynamic": "porter:subscribeDynamic",
    "default_tools": { "@id": "porter:defaultTool", "@container": "@set" },
    "Pattern": "porter:Pattern",
    "PatternRole": "porter:PatternRole"
  },
  "@id": "porter:pattern/distillation",
  "@type": "Pattern",
  "id": "distillation",
  "name": "Distillation",
  "description": "A larger/stronger expert model reasons and creates a step-by-step plan, which a smaller learner model executes. The graph tracks plan progress and enables clarification requests.",
  "bus_flow": "task -> role:expert -> graph -> role:learner -> response ; role:learner -> clarify -> role:expert",
  "builtin": true,
  "roles": [
    {
      "@type": "PatternRole",
      "id": "expert",
      "name": "Expert",
      "description": "Analyzes tasks, creates detailed plans for the learner to execute",
      "min": 1,
      "max": 1,
      "system_prompt_suffix": "You are the expert in a Distillation team. Analyze the task, break it down into clear steps, and use plan_write for each step with an order number and expected outcome. Identify potential pitfalls. You have read-only tools for context gathering. Do NOT execute the plan — the learner will implement it.",
      "auto_tools": ["plan_write", "send_message"],
      "subscribe": ["task", "clarify", "control"],
      "default_tools": ["read_file", "glob", "grep", "list_dir"]
    },
    {
      "@type": "PatternRole",
      "id": "learner",
      "name": "Learner",
      "description": "Executes the expert's plan step by step, reports progress",
      "min": 1,
      "max": 1,
      "system_prompt_suffix": "You are the learner in a Distillation team. Follow this exact loop for every step:\n1. Call plan_query to get the next step. Note its order number.\n2. Execute the step using your tools.\n3. Immediately call step_update with that same order number and state: \"done\" (or \"failed\" with notes) — before doing anything else. Example: step_update({\"order\": 1, \"state\": \"done\", \"notes\": \"created hello.deno.ts\"}).\n4. Only then call plan_query again for the next step.\n\nNever repeat a tool call for a step you have already completed. If plan_query returns \"No pending plan steps\", you are done — stop, do not re-run earlier actions. If something is unclear or the plan seems wrong, send a message to the clarify channel instead of guessing.",
      "auto_tools": ["plan_query", "step_update", "send_message"],
      "subscribe": ["guidance", "control"],
      "default_tools": ["read_file", "write_file", "edit_file", "bash", "git"]
    },
    {
      "@type": "PatternRole",
      "id": "librarian",
      "name": "Librarian",
      "description": "Optional: curates which session-local memories are worth keeping across sessions, and resolves conflicts in durable memory",
      "min": 0,
      "max": 1,
      "system_prompt_suffix": "You are the librarian for this team. Other agents record memories locally with the memory tool as they work. Periodically use memory({method:\"search\", scope:\"local\"}) to review what's been recorded. Use memory_admin({method:\"promote\", id:\"...\"}) to promote genuinely reusable facts and lessons to durable, cross-session memory — not every observation deserves to be durable, only stable facts and generalizable lessons. If a promotion conflicts with an existing durable fact, memory_admin will tell you and give you an id to resolve it with memory_admin({method:\"adjudicate\", ...}).",
      "auto_tools": ["memory", "memory_admin", "send_message"],
      "subscribe": ["memory", "control"],
      "default_tools": []
    }
  ]
}
